# WeatherAPI.com key — create one at https://www.weatherapi.com/
#
# SKY CRED is a browser-only app (no backend), so this key is inlined into the built JavaScript
# and is visible to every visitor. Keep it out of Git, but treat it as a low-value, restrictable
# key — not as a secret. See README.md → "Security note".
WEATHER_API_KEY=your_weatherapi_key_here

# Optional: use a different WeatherAPI-compatible base URL (defaults to the public API).
# WEATHER_API_BASE_URL=https://api.weatherapi.com/v1
